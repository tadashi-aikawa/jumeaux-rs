  {
    "name": "query-cp932",
    "input": {
      "endpoint": {
        "name": "one",
        "host": "http://localhost/base"
      },
      "request": {
        "path": "/",
        "qs": {
          "key": [
            "日本",
            "",
            "+ &"
          ]
        },
        "url_encoding": "cp932"
      }
    },
    "expected": {
      "value": {
        "original_url": "http://localhost/base/?key=%93%FA%96%7B&key=&key=%2B+%26",
        "url": "http://localhost/base/?key=%93%FA%96%7B&key=&key=%2B+%26",
        "headers": {
          "user-agent": "jumeaux/<version>"
        },
        "body_hex": ""
      }
    }
  },
  {
    "name": "query-first-case",
    "input": {
      "endpoint": {
        "name": "one",
        "host": "http://localhost/base",
        "query": {
          "overwrite": {
            "key/i": [
              "new"
            ]
          },
          "remove": [
            "DROP/i"
          ]
        }
      },
      "request": {
        "path": "/",
        "qs": {
          "Key": [
            "1"
          ],
          "KEY": [
            "2"
          ],
          "drop": [
            "x"
          ]
        }
      }
    },
    "expected": {
      "value": {
        "original_url": "http://localhost/base/?Key=new&KEY=2",
        "url": "http://localhost/base/?Key=new&KEY=2",
        "headers": {
          "user-agent": "jumeaux/<version>"
        },
        "body_hex": ""
      }
    }
  },
  {
