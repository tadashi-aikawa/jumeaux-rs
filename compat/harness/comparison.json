{
  "report_fields": {
    "version": "string",
    "key": "key_reference",
    "retry_hash": "retry_reference",
    "summary.time.start": "datetime",
    "summary.time.end": "datetime",
    "summary.time.elapsed_sec": "nonnegative",
    "trials.*.request_time": "datetime",
    "trials.*.one.response_sec": "nullable_nonnegative",
    "trials.*.other.response_sec": "nullable_nonnegative"
  },
  "lowercase_header_paths": [
    "trials.*.one.response_header",
    "trials.*.other.response_header"
  ],
  "text_rules": [
    {"field": "version", "pattern": "(?m)^(Version: ).+$", "replacement": "\\1<version>"},
    {"field": "version", "pattern": "jumeaux/[0-9.]+", "replacement": "jumeaux/<version>"},
    {"field": "response_sec", "pattern": "(?m)^(\\[\\d+ / \\d+\\] (?:One:|Other:)[ ]+\\d+ / )\\d+(?:\\.\\d+)?s( /)", "replacement": "\\1<response_sec>\\2"},
    {"field": "elapsed_sec", "pattern": "(?m)^(\\[\\d+ / \\d+\\] ⏰ [^\\n]+: +)\\d+\\.\\d{1,3}ms$", "replacement": "\\1<elapsed_sec>"},
    {"field": "response_sec", "pattern": "<\\d+(?:\\.\\d+)?s - \\d+(?:\\.\\d+)?s>", "replacement": "<response_sec>"}
  ],
  "excluded_transport_lines": {
    "streams": ["run.stderr"],
    "patterns": ["^Starting new HTTP connection \\(\\d+\\): localhost:8000$", "^http://localhost:8000 \\\"GET /api/[^\\n]+ HTTP/1\\.1\\\" \\d+ \\d+$"]
  },
  "unordered_text_blocks": [
    {"streams": ["cli.stderr"], "start": "✨ [Valid names] ✨", "line_pattern": "[a-z][a-z0-9_]*"}
  ],
  "python_mismatches": {"header_ignore_case": "header_ignore_control"},
  "rust_comparison_default": {"judge_response_header": false, "ignore_response_header_keys": ["Content-Length", "Date"]},
  "rust_comparison_by_case": {
    "judge_response_headers": {"judge_response_header": true, "ignore_response_header_keys": ["Last-Modified"]},
    "header_ignore_control": {"judge_response_header": true, "ignore_response_header_keys": ["Last-Modified"]},
    "header_ignore_case": {"judge_response_header": true, "ignore_response_header_keys": ["last-modified"]}
  },
  "case_contracts": {
    "threads_2": {"summary.concurrency": {"threads": 2, "processes": 1}},
    "processes_2": {"summary.concurrency": {"threads": 1, "processes": 2}},
    "threads_and_processes": {"summary.concurrency": {"threads": 1, "processes": 2}},
    "header_ignore_case": {"summary.status": {"same": 0, "different": 1, "failure": 0}},
    "header_ignore_control": {"summary.status": {"same": 1, "different": 0, "failure": 0}},
    "header_condition_case": {"summary.status": {"same": 2, "different": 0, "failure": 0}},
    "encoding_fixed": {"summary.status": {"same": 0, "different": 1, "failure": 0}},
    "output_encoding": {"summary.output.encoding": "utf-16"}
  },
  "text_report_references": ["key"],
  "request_records": "multiset_with_occurrence_count",
  "notification_header_exclusions": ["user-agent"],
  "request_header_rules": {
    "always_compare": ["content-type", "accept", "accept-encoding", "connection", "content-length", "cookie", "user-agent"],
    "configured_sources": ["summary.one.headers", "summary.other.headers", "trials.*.headers"],
    "name_case": "insensitive",
    "order": "ignore",
    "unconfigured": "ignore",
    "automatic_examples": ["host"]
  },
  "numeric_tolerance": 0,
  "fixed_inputs": {
    "$DATETIME(%Y-%m-%d)(-86400)": "2000-01-01",
    "$DATETIME(%Y-%m-%d)(86400)": "2000-01-03"
  },
  "server": {
    "api_port": 8000,
    "notification_port": 8001,
    "http_date": "Sat, 01 Jan 2000 00:00:00 GMT",
    "last_modified": {
      "one": "Sat, 01 Jan 2000 00:00:00 GMT",
      "other": "Sun, 02 Jan 2000 00:00:00 GMT"
    },
    "server_version": "SimpleHTTP/0.6 Python/compat"
  }
}
